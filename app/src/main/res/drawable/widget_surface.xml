<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo común de los widgets. El color cambia solo con el modo oscuro del
     sistema (values-night) y las esquinas se ven redondeadas también antes de
     Android 12, donde GlanceModifier.cornerRadius no tiene efecto. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
