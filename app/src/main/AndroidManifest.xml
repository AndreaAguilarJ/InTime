<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Acceso especial solicitado por el usuario para medir uso de apps. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Red: Appwrite y Gemini. El tráfico HTTP sin TLS se bloquea en application. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bloqueo y overlays persistentes. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ACTION_CALL sí requiere permiso; SMS, cámara y contactos se abren mediante
         intents de otras apps y no necesitan acceso directo a sus datos. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Permiso especial revocable. El scheduler comprueba canScheduleExactAlarms()
         y usa una alarma inexacta cuando no está concedido. Su uso debe declararse
         y justificarse también en Play Console. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- El bloqueo contextual mantiene ubicación en segundo plano. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <queries>
        <!-- Ver apps lanzables en Android 11+ -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MomentumApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Momentum"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Momentum">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service para persistir el idioma seleccionado por el usuario -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Minimal Launcher Activity -->
        <activity
            android:name=".minimal.MinimalLauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Momentum">
            <!-- Home launcher capability for minimal phone mode -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Birth Date Config Activity -->
        <activity
            android:name=".ui.BirthDateActivity"
            android:exported="false"
            android:theme="@style/Theme.Momentum" />

        <!-- Widget Launch Activity -->
        <activity
            android:name=".ui.WidgetLaunchActivity"
            android:exported="false"
            android:theme="@style/Theme.Momentum" />

        <!-- App Blocked Activity -->
        <activity
            android:name=".ui.AppBlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Momentum" />

        <!-- In-App Feature Blocked Activity -->
        <activity
            android:name=".ui.InAppBlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Momentum.NoActionBar" />

        <!-- Website Blocked Activity -->
        <activity
            android:name=".ui.screen.websiteblock.WebsiteBlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Momentum" />

        <!-- Life Weeks Widget -->
        <receiver
            android:name=".widget.LifeWeeksWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/life_weeks_widget_info" />
        </receiver>

        <!-- Motivational Quote Widget -->
        <receiver
            android:name=".widget.QuoteWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quote_widget_info" />
        </receiver>

        <!-- Year Progress Widget -->
        <receiver
            android:name=".widget.YearProgressWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/year_progress_widget_info" />
        </receiver>

        <!-- Motivational Message Widget -->
        <receiver
            android:name=".widget.MotivationalMessageWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/motivational_message_widget_info" />
        </receiver>

        <!-- Boot Receiver to start monitoring service after device reboot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Device Admin Receiver for Uninstall Prevention -->
        <!-- Feature solicitada: "I would much rather have it to block myself from deleting it" -->
        <receiver
            android:name=".receiver.InTimeDeviceAdminReceiver"
            android:label="@string/device_admin_label"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>

        <!-- Motivational Notification Receiver for notification actions -->
        <receiver
            android:name=".receiver.MotivationalNotificationReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.momentummm.app.action.MOTIVATIONAL_LOVE" />
                <action android:name="com.momentummm.app.action.MOTIVATIONAL_ANOTHER" />
                <action android:name="com.momentummm.app.action.MOTIVATIONAL_DISMISS" />
            </intent-filter>
        </receiver>

        <!-- Alarmas exactas de los mensajes motivacionales.
             Sustituye a los OneTimeWorkRequest que se reprogramaban a sí mismos
             y cuya cadena se rompía de forma permanente. -->
        <receiver
            android:name=".receiver.MotivationalAlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.momentummm.app.action.MOTIVATIONAL_ALARM" />
            </intent-filter>
        </receiver>

        <!-- Servicio interno de WorkManager. Ningún Worker actual usa modo
             foreground, por lo que no se declara un tipo especial innecesario. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            tools:node="merge" />

        <!-- MomentumApplication implementa Configuration.Provider (inicialización
             a demanda de WorkManager). Mientras el inicializador por defecto de
             App Startup siguiera declarado, WorkManager se inicializaba con la
             configuración POR DEFECTO y la de la app se ignoraba, incluida la
             HiltWorkerFactory: MotivationalNotificationWorker está anotado
             @HiltWorker y sin esa fábrica WorkManager no puede construirlo, así
             que la notificación motivacional nunca se ejecutaba.
             Además, dejarlo declarado hace fallar `lintVitalRelease` con
             RemoveWorkManagerInitializer, lo que impedía generar cualquier
             artefacto de release. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- App Monitoring Service for blocking distracting apps -->
        <service
            android:name=".service.AppMonitoringService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property 
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app_usage_monitoring_and_blocking" />
        </service>

        <!-- Focus Timer Service for Pomodoro sessions -->
        <service
            android:name=".service.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property 
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focus_timer_countdown" />
        </service>

        <!-- App Block Overlay Service -->
        <!-- Es foreground service: se arranca con startForegroundService desde
             BlockEnforcer y debe sobrevivir mientras la app bloqueada siga abierta. -->
        <service
            android:name=".ui.overlay.AppBlockOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app_blocking_overlay" />
        </service>

        <!-- Floating Timer Overlay Service -->
        <service
            android:name=".service.FloatingTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property 
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_timer_overlay" />
        </service>

        <!-- Nuclear Mode Timer Service -->
        <service
            android:name=".service.NuclearModeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property 
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="nuclear_mode_app_blocking" />
        </service>

        <!-- Context Blocking Location Service -->
        <service
            android:name=".service.ContextBlockingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Accessibility Service to appear in system Accessibility settings -->
        <service
            android:name=".accessibility.MomentumAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Website Block Accessibility Service -->
        <service
            android:name=".service.WebsiteBlockService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/website_block_accessibility_service" />
        </service>

        <!-- File Provider for export functionality -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>